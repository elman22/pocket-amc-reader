<!-- Foreground of the items of the list and the grid: ripple when touched and a highlight for the movie which is
     displayed in the detail pane (the activated state of the item, see MoviesAdapter#setActivatedPosition) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?attr/selectableItemBackground" />
    <item>
        <selector>
            <item android:state_activated="true">
                <color android:color="@color/list_item_activated" />
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
</layer-list>
